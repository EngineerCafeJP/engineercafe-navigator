# ===========================================
# Engineer Cafe Navigator Backend
# ===========================================

# OpenRouter API (Primary - Recommended)
# Get your key at: https://openrouter.ai/keys
# Supports 400+ models: OpenAI, Google, Anthropic, Meta, Mistral
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI API (LLM Judge / Embeddings)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Tavily (Web Search - Required for web search agent)
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Google Calendar (ICS format - Required for event agent)
# Public ICS feed URL (no API key required)
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/public/basic.ics

# Connpass API (Optional - for event search)
# Get your key at: https://connpass.com/about/api/
# CONNPASS_API_KEY=your-connpass-api-key

# Supabase Configuration
# Override with .env.local for local development (supabase start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-supabase-service-role-key

# PostgreSQL connection URI for LangGraph Checkpointer
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud: Get from Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application Settings
ENVIRONMENT=development
PORT=8000

# Application URL (for OpenRouter tracking)
APP_URL=http://localhost:3000

# API auth / CORS (optional in local development, required to fail closed outside dev)
# API_SECRET_KEY=your-api-secret-key
# ALLOWED_ORIGINS=http://localhost:3000

# Fast LLM (OpenRouter primary + optional Cerebras) — see backend/llm/model_resolve.py
# FAST_LLM_PRIMARY_PROVIDER=gemini
# FAST_LLM_PRIMARY_MODEL=google/gemini-3.1-flash-lite-preview
# FAST_LLM_FALLBACK_PROVIDER=gemini
# FAST_LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# FAST_LLM_TERTIARY_PROVIDER=cerebras
# CEREBRAS_ENABLED=false
# CEREBRAS_API_KEY=
# CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1/chat/completions
# CEREBRAS_FAST_MODEL=gpt-oss-120b
# CEREBRAS_REASONING_EFFORT=low
# GEMINI_OPENROUTER_EXTRA_JSON=

# Deep reasoning (OpenRouter slug) — overrides general_knowledge primary
# DEEP_REASONING_MODEL=google/gemini-3.1-pro-preview
# DEEP_REASONING_FALLBACK_MODEL=google/gemini-2.5-pro

# Shared OpenRouter chat models (defaults in code use 3.1 Flash-Lite)
# TRAG_TRANSLATION_MODEL=google/gemini-3.1-flash-lite-preview
# STT_POSTPROCESS_MODEL=google/gemini-3.1-flash-lite-preview
# VISION_MODEL=openai/gpt-4.1-nano

# Embedding Configuration (Optional)
# Must match the dimension of knowledge_base.content_embedding column
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# TTS Configuration (Optional)
# TTS_PROVIDER=voicevox          # voicevox (default) | piper | google
# VOICEVOX_API_URL=http://localhost:50021
# KOKORO_API_URL=http://localhost:8880
#
# piper-plus TTS (TTS_PROVIDER=piper の場合に使用)
# tsukuyomi-chan-6lang モデルで日本語・英語等に対応。モデルは自動ダウンロード。
# セットアップ: docker-compose --profile piper up piper-plus
# PIPER_PLUS_API_URL=http://localhost:8090
# PIPER_SPEED=0.65          # 話速 (1.0=標準, <1.0=遅い, >1.0=速い)

# LangSmith tracing (Optional)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=engineer-cafe-navigator

# Discord alerts (Optional)
# DISCORD_WEBHOOK_URL=
