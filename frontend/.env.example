# ===========================================================================
# Engineer Cafe Navigator — Frontend Environment Variables
# Deployed to Vercel (Dev environment)
#
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# Legend:
#   [REQUIRED]    — App will not function without this
#   [RECOMMENDED] — Some features degrade without this
#   [OPTIONAL]    — Graceful degradation; leave blank if unused
#
# Note:
#   This file tracks the manually managed env vars documented for frontend/src.
#   Platform-managed/runtime flags such as NODE_ENV and VERCEL_DEPLOYMENT_ID are
#   intentionally excluded.
# ===========================================================================

# ---------------------------------------------------------------------------
# [REQUIRED] Database (Supabase)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# [REQUIRED] Backend API Proxy
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=your-backend-api-key
# Direct browser -> backend QA is opt-in. Default/rollback is the Next /api/qa proxy.
# This does not expose BACKEND_API_KEY to the browser.
# NEXT_PUBLIC_QA_API_MODE=proxy
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# [RECOMMENDED] Supabase Admin Access (server-only; used by legacy cron/admin helpers)
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# [REQUIRED for /api/cron/update-knowledge-base] OpenRouter embeddings
# ---------------------------------------------------------------------------
# Connpass knowledge sync writes RAG-visible rows only when this server-only
# secret is present; the cron fails fast without it.
OPENROUTER_API_KEY=your-openrouter-api-key

# ---------------------------------------------------------------------------
# [RECOMMENDED] CRON Job Authentication
# ---------------------------------------------------------------------------
# CRON_SECRET=your-cron-secret

# ---------------------------------------------------------------------------
# [RECOMMENDED] Protected Admin/Cron/Monitoring API Route Authentication
# ---------------------------------------------------------------------------
# Shared bearer token for /api/admin/*, /api/cron/*, and /api/monitoring/* middleware protection
ADMIN_API_SECRET=your-admin-api-secret

# ---------------------------------------------------------------------------
# [OPTIONAL] Alerts & Monitoring
# ---------------------------------------------------------------------------
# ALERT_WEBHOOK_SECRET=
# SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# [OPTIONAL] Redis Cache (Upstash)
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# ---------------------------------------------------------------------------
# [OPTIONAL] Feature Toggles
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_FACIAL_EXPRESSION=false
NEXT_PUBLIC_USE_WEB_SPEECH_API=false
# NEXT_PUBLIC_SKIP_BACKEND=false
# COSCUP 2026 デモキオスク: true にすると初期表示言語と初回設定モーダルの初期選択が英語になります
# NEXT_PUBLIC_DEMO_MODE=true

# Kiosk slide guide: default = PDF (public/reception/engineer-cafe-ja.pdf). Use Marp + /api/marp with:
# NEXT_PUBLIC_RECEPTION_SLIDE_RENDERER=marp

# Kiosk device timing defaults (ms)
# NEXT_PUBLIC_KIOSK_SENSOR_INITIAL_LOOKBACK_MS=60000
# NEXT_PUBLIC_KIOSK_DEVICE_WELCOME_COOLDOWN_MS=60000
# NEXT_PUBLIC_KIOSK_IDLE_MS=60000

# Playwright voice-live STT preflight timeout (default: 60000)
# PLAYWRIGHT_VOICE_LIVE_WARMUP_TIMEOUT_MS=60000
