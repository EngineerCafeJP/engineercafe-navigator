{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/update-knowledge-base",
      "schedule": "30 19 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/update-knowledge-base/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/ocr/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/reception/start/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/reception/status/[receptionSessionId]/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/reception/sensor-status/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/voice/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/voice/filler/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/qa/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/slides/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/character/route.ts": {
      "maxDuration": 120
    }
  },
  "env": {
    "NEXT_RUNTIME": "nodejs"
  },
  "regions": ["hnd1"]
}
