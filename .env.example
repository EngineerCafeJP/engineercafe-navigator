# ===========================================================================
# Engineer Cafe Navigator — Monorepo Environment Variables
# ===========================================================================
#
# This monorepo has separate env files for frontend and backend.
# Copy the relevant .env.example to .env.local in each directory:
#
#   # Frontend (Next.js)
#   cp frontend/.env.example frontend/.env.local
#
#   # Backend (FastAPI)
#   cp backend/.env.example backend/.env
#
# For production/staging deployment configs, see:
#   - frontend/.env.production.example   (Vercel)
#   - backend/.env.production.example    (Cloud Run)
#   - backend/.env.staging.example       (Cloud Run staging)
#
# ---------------------------------------------------------------------------
# Shared Services (used by both frontend and backend)
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_CREDENTIALS=./config/service-account-key.json

# OpenAI (embeddings — 1536 dimensions, text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key
